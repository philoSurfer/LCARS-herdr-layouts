{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    18,
    22
  ],
  "theme": "graphite",
  "colors": {
    "chrome": "#000000",
    "canvas": "#000000",
    "surface": "#000000",
    "popover": "#111419",
    "raised": "#2f3749",
    "hover": "#9ea5ba22",
    "selected": "#9ea5ba33",
    "border": "#2f3749",
    "input": "#111419",
    "muted": "#9ea5ba",
    "dim": "#6d748c",
    "accent": "#9ea5ba",
    "accent_foreground": "#000000",
    "solid": "#e7442a",
    "solid_foreground": "#000000",
    "working": "#9ea5ba",
    "blocked": "#e7442a",
    "done": "#f2b24a",
    "idle": "#6d748c",
    "unknown": "#6d748c",
    "background": "#000000",
    "foreground": "#c9cfdd",
    "selection": "#2f3749",
    "ansi0": "#111419",
    "ansi1": "#e7442a",
    "ansi2": "#8fbf9a",
    "ansi3": "#e0b060",
    "ansi4": "#7f93c8",
    "ansi5": "#a892c8",
    "ansi6": "#8fb8c8",
    "ansi7": "#9ea5ba",
    "ansi8": "#6d748c",
    "ansi9": "#ff6a50",
    "ansi10": "#aed6b8",
    "ansi11": "#f2cf8a",
    "ansi12": "#a3b3de",
    "ansi13": "#c4b2dc",
    "ansi14": "#b3d3df",
    "ansi15": "#e6e9f2"
  },
  "ui_font": "Antonio",
  "background": "#000000",
  "children": [
    {
      "id": "top",
      "type": "block",
      "content": {
        "mod": "lcars25",
        "props": {
          "part": "top"
        }
      },
      "size": {
        "px": 44
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "resizable": false,
      "children": [
        {
          "id": "work",
          "type": "column",
          "padding": [
            4,
            10
          ],
          "gap": 6,
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "lcars25",
                "props": {
                  "part": "tabs"
                }
              },
              "size": {
                "px": 26
              }
            },
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 6,
                  "radius": 10,
                  "background": "#000000",
                  "border": {
                    "width": 1,
                    "color": "#2f3749"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#9ea5ba"
                  },
                  "header": {
                    "content": {
                      "mod": "lcars25",
                      "props": {
                        "part": "pane"
                      }
                    },
                    "height": 20,
                    "position": "top",
                    "reveal": "always"
                  },
                  "lone": true
                }
              }
            }
          ]
        },
        {
          "id": "sidebar",
          "type": "block",
          "content": {
            "mod": "lcars25",
            "props": {
              "part": "side",
              "alert_after": 120
            }
          },
          "size": {
            "px": 220
          }
        }
      ]
    },
    {
      "id": "bottom",
      "type": "block",
      "content": {
        "mod": "lcars25",
        "props": {
          "part": "bottom"
        }
      },
      "size": {
        "px": 34
      }
    }
  ]
}